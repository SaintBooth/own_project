# PromptSpace — Environment Variables
# Скопируй в .env и заполни значения
# Источник: promptspace-release.md §19

# ── Django ────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me-generate-with-python-secrets-token-urlsafe-50
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prompt_marketplace
# Через PgBouncer (для приложения)
DATABASE_URL=postgresql://postgres:postgres@pgbouncer:5432/prompt_marketplace
# Напрямую к PostgreSQL (только для manage.py migrate)
DATABASE_DIRECT_URL=postgresql://postgres:postgres@db:5432/prompt_marketplace

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── HashiCorp Vault ───────────────────────────────────────────────────────
VAULT_ADDR=http://vault:8200
# DEV ONLY: токен для dev-режима. В production — только AppRole!
VAULT_DEV_TOKEN=dev-root-token
# Production (AppRole):
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
VAULT_TRANSIT_KEY_NAME=promptspace-kek
VAULT_TRANSIT_MOUNT=transit

# ── Yandex Object Storage ─────────────────────────────────────────────────
YOS_ACCESS_KEY_ID=
YOS_SECRET_ACCESS_KEY=
YOS_BUCKET_NAME=promptspace-media
YOS_ENDPOINT_URL=https://storage.yandexcloud.net
YOS_REGION=ru-central1

# ── YandexGPT Embeddings (152-ФЗ: только РФ провайдеры!) ─────────────────
# OpenAI и зарубежные провайдеры — ЗАПРЕЩЕНЫ
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_EMBEDDINGS_MODEL=text-search-doc/latest
EMBEDDING_DIMENSION=256

# ── Robokassa Split ───────────────────────────────────────────────────────
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_IS_TEST=True
# IP Robokassa для whitelist webhook (заполни перед production)
ROBOKASSA_IP_WHITELIST=

# ── Dadata KYC API ────────────────────────────────────────────────────────
DADATA_API_KEY=
DADATA_SECRET_KEY=

# ── Email / Unisender ─────────────────────────────────────────────────────
UNISENDER_API_KEY=
UNISENDER_LIST_ID=
# SMTP fallback
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_SSL=True
DEFAULT_FROM_EMAIL=noreply@promptspace.ru

# ── Telegram Bot (опционально, 152-ФЗ: без ПДн в сообщениях) ─────────────
TELEGRAM_ENABLED=False
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── OAuth провайдеры ──────────────────────────────────────────────────────
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
VK_OAUTH_CLIENT_ID=
VK_OAUTH_CLIENT_SECRET=
TELEGRAM_BOT_NAME=

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_TTL=900      # 15 минут в секундах
JWT_REFRESH_TOKEN_TTL=604800  # 7 дней в секундах

# ── Платформа ─────────────────────────────────────────────────────────────
PLATFORM_COMMISSION_RATE=0.20
SITE_URL=http://localhost:3000

# ── Мониторинг ────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# ── AISP Security Scan (ADR-016) ──────────────────────────────────────────
AISP_PROVIDER=stub   # stub | llmguard | yandex
# LLM Guard (self-hosted):
# LLMGUARD_URL=http://llmguard:8080
# Yandex Foundation Models Moderation:
# YANDEX_MODERATION_API_KEY=

# ── Django Ninja ──────────────────────────────────────────────────────────
# В production оставить пустым!
DJANGO_NINJA_DOCS_URL=/api/docs

# ── OpenTelemetry ─────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=promptspace-backend
